{
  "name": "our-budget",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local budgeting website: TypeScript SPA, hand-rolled event store and mediator, SQLite.",
  "scripts": {
    "dev": "concurrently -n server,client \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch src/server/main.ts",
    "dev:client": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "NODE_OPTIONS=\"--import tsx --disable-warning=ExperimentalWarning\" cucumber-js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.3.0",
    "@types/node": "^26.6.6",
    "concurrently": "^10.0.6",
    "playwright": "^1.65.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
